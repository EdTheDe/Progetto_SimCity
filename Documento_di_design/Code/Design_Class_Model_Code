classDiagram
    %% ==========================================
    %% PATTERN OBSERVER (Separazione Logica / UI)
    %% ==========================================
    class Subject {
        <<interface>>
        +attach(Observer o)
        +detach(Observer o)
        +notifyObservers()
    }
    class Observer {
        <<interface>>
        +update(StatoCitta stato)
    }

    %% ==========================================
    %% CORE ENGINE & PERSISTENCE (Architettura)
    %% ==========================================
    class SimulationEngine {
        -Citta citta
        -List~Observer~ observers
        +tick()
        +costruisciEntita(String tipo, int x, int y)
        +attivaPolitica(PoliticaStrategy p)
    }

    class PersistenceManager {
        <<interface>>
        +salvaStato(Citta citta, String path)
        +caricaStato(String path) : Citta
    }
    class JsonCityRepository {
        +salvaStato(Citta citta, String path)
        +caricaStato(String path) : Citta
    }

    %% ==========================================
    %% DOMAIN MODEL - CLASSI CENTRALI
    %% ==========================================
    class Citta {
        -StatoCitta stato
        -GrigliaUrbana griglia
        -List~PoliticaStrategy~ politicheAttive
        -List~EventoSpeciale~ eventiAttivi
        +aggiornaCitta()
    }

    class StatoCitta {
        -int finanze
        -int popolazione
        -int felicita
        -int lavoro
        -int sicurezza
        -int sanita
        -int ecologia
        +aggiornaMetrica(String metrica, int valore)
    }

    class GrigliaUrbana {
        -int dimensione
        -Cella[][] celle
        +getCella(int x, int y) : Cella
        +posizionaEntita(EntitaUrbana e, int x, int y)
    }

    class Cella {
        -int coordX
        -int coordY
        -EntitaUrbana occupante
        +isLibera() : boolean
    }

    %% ==========================================
    %% PATTERN FACTORY
    %% ==========================================
    class EntitaUrbanaFactory {
        +creaEntita(String tipo) : EntitaUrbana
    }

    %% ==========================================
    %% GERARCHIA ENTITÀ URBANE (Ereditarietà)
    %% ==========================================
    class EntitaUrbana {
        <<abstract>>
        -int costoPiazzamento
        -int livello
        +applicaEffettoTick(StatoCitta stato)*
    }

    class Edificio {
        <<abstract>>
        -int fabbisognoEnergetico
        -int fabbisognoIdrico
    }

    class Infrastruttura {
        <<abstract>>
        -int capacitaMassima
        -int costoMantenimento
    }

    class Strada {
        +applicaEffettoTick(StatoCitta stato)
    }

    %% Sottoclassi Edificio
    class Residenziale {
        -int capacitaAbitativa
        +applicaEffettoTick(StatoCitta stato)
    }
    class Industriale {
        -int inquinamentoBase
        +applicaEffettoTick(StatoCitta stato)
    }
    class Commerciale {
        -int redditoBase
        +applicaEffettoTick(StatoCitta stato)
    }

    %% Sottoclassi Infrastruttura
    class EdificioElettrico {
        +immettiEnergia(ReteElettrica rete)
    }
    class EdificioIdrico {
        +immettiAcqua(ReteIdrica rete)
    }
    class Statale {
        <<abstract>>
    }
    class Polizia { +applicaEffettoTick(StatoCitta stato) }
    class Scuola { +applicaEffettoTick(StatoCitta stato) }
    class Pompieri { +applicaEffettoTick(StatoCitta stato) }

    %% Reti Logiche
    class ReteElettrica {
        -int caricoAttuale
        +bilanciaRete()
    }
    class ReteIdrica {
        -int pressioneAttuale
        +bilanciaRete()
    }

    %% ==========================================
    %% PATTERN STRATEGY (Politiche)
    %% ==========================================
    class PoliticaStrategy {
        <<interface>>
        +applicaRegola(StatoCitta stato)
    }
    class TassaAmbientale {
        +applicaRegola(StatoCitta stato)
    }
    class EspansioneIndustriale {
        +applicaRegola(StatoCitta stato)
    }

    %% Eventi Speciali
    class EventoSpeciale {
        -String tipoEvento
        -int durata
        -int intensita
        +innescaEffetto(StatoCitta stato)
    }

    %% ==========================================
    %% RELAZIONI E COLLEGAMENTI
    %% ==========================================
    Subject <|.. SimulationEngine : implements
    Observer <|.. DashboardView : implements (UI)

    SimulationEngine --> Citta : gestisce
    SimulationEngine --> EntitaUrbanaFactory : usa
    SimulationEngine --> PersistenceManager : usa
    PersistenceManager <|.. JsonCityRepository : implements

    Citta *-- StatoCitta : composizione
    Citta *-- GrigliaUrbana : composizione
    Citta o-- PoliticaStrategy : aggregazione
    Citta o-- EventoSpeciale : aggregazione

    GrigliaUrbana *-- Cella : composizione
    Cella o-- EntitaUrbana : contiene (0..1)

    EntitaUrbana <|-- Edificio : inheritance
    EntitaUrbana <|-- Infrastruttura : inheritance
    EntitaUrbana <|-- Strada : inheritance

    Edificio <|-- Residenziale
    Edificio <|-- Industriale
    Edificio <|-- Commerciale

    Infrastruttura <|-- EdificioElettrico
    Infrastruttura <|-- EdificioIdrico
    Infrastruttura <|-- Statale

    Statale <|-- Polizia
    Statale <|-- Scuola
    Statale <|-- Pompieri

    EdificioElettrico --> ReteElettrica : alimenta
    EdificioIdrico --> ReteIdrica : alimenta

    PoliticaStrategy <|.. TassaAmbientale
    PoliticaStrategy <|.. EspansioneIndustriale