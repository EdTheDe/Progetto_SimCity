classDiagram
    class SimulationEngine {
        -UrbanGrid grid
        -StatoCitta state
        -PoliticaStrategy activePolicy
        +tick()
    }

    class StatoCitta {
        -int finances
        -int population
        -int happiness
        -int jobs
        -int safety
        -int health
        -int ecology
    }

    class UrbanGrid {
        -int width
        -int height
        -Cell[][] cells
        +placeEntity(UrbanEntity entity, int x, int y)
    }

    class Cell {
        -int x
        -int y
        -UrbanEntity occupant
    }

    class UrbanEntity {
        <<abstract>>
        -int placementCost
        -int developmentLevel
    }

    class Road {
    }

    class Building {
        <<abstract>>
        -int energyDemand
        -int waterDemand
    }

    class Commercial {
        -int baseIncome
    }

    class Industrial {
        -int basePollution
        -int baseJobs
    }

    class Residential {
        -int housingCapacity
    }

    class Infrastructure {
        <<abstract>>
        -int maxCapacity
        -int maintenanceCost
    }

    class PowerPlant {
    }

    class WaterPlant {
    }

    class StateBuilding {
        <<abstract>>
    }

    class PoliceStation {
    }

    class School {
    }

    class FireStation {
    }

    class PoliticaStrategy {
        <<interface>>
        +applyEffects(StatoCitta state)
    }

    SimulationEngine "1" --> "1" UrbanGrid : contains
    SimulationEngine "1" --> "1" StatoCitta : manages
    SimulationEngine "1" --> "0..*" PoliticaStrategy : applies
    UrbanGrid "1" --> "20x20" Cell : subdivides into
    Cell "1" --> "0..1" UrbanEntity : hosts
    
    UrbanEntity <|-- Road
    UrbanEntity <|-- Building
    UrbanEntity <|-- Infrastructure

    Building <|-- Residential
    Building <|-- Industrial
    Building <|-- Commercial

    Infrastructure <|-- PowerPlant
    Infrastructure <|-- WaterPlant
    Infrastructure <|-- StateBuilding

    StateBuilding <|-- PoliceStation
    StateBuilding <|-- School
    StateBuilding <|-- FireStation