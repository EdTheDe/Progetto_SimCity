sequenceDiagram
    participant API as SimulazioneAPI
    participant Factory as BuildingFactory
    participant Engine as SimulationEngine
    participant Grid as UrbanGrid
    participant Stato as CityState

    API->>Engine: costruisci("Industriale", x, y)
    activate Engine
    
    Engine->>Factory: createBuilding("Industriale")
    activate Factory
    Factory-->>Engine: istanza (Building polimorfico)
    deactivate Factory
    
    Engine->>Grid: placeEntity(istanza, x, y)
    activate Grid
    
    alt Spazio Libero
        Grid-->>Engine: true
        deactivate Grid
        
        Engine->>Stato: deductBudget(istanza.getCosto())
        activate Stato
        Stato-->>Engine: confermato
        deactivate Stato
        
        Engine-->>API: successo
    else Spazio Occupato
        Grid-->>Engine: false
        Engine-->>API: eccezione("Cella Occupata")
    end
    
    deactivate Engine
